{
  "name": "pet-plugin-bili",
  "version": "0.2.0",
  "description": "让当前宠物自主浏览 B 站、理解视频、记录日记，并按设置处理互动。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "bilibili",
    "agent",
    "diary"
  ],
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:upstream": "node --test tests/*.test.mjs",
    "test:migration": "npm run test:engine && npm run test:controller && npm run test:build",
    "build": "python3 scripts/build-plugin.py",
    "test:engine": "node --test tests/engine.test.mjs",
    "test:controller": "node --test tests/controller.test.mjs",
    "test:electron": "node tests/electron-e2e.cjs",
    "test:build": "node --test tests/build.test.mjs",
    "test:delivery": "npm test && npm run build && npm run test:electron"
  },
  "main": "index.cjs",
  "exports": {
    ".": "./index.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.cjs",
    "manifest.json",
    "src",
    "panel",
    "lib",
    "tools",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "bin",
    "scripts/build-ffmpeg.sh"
  ],
  "license": "MIT",
  "dependencies": {
    "qrcode": "1.5.4"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "ffmpeg-static": "5.3.0"
  }
}
